{
  "name": "twotab",
  "version": "1.0.0",
  "description": "TwoTab is a privacy-first, lightweight Google Chrome browser extension designed to replace OneTab. It allows users to quickly save all open tabs in a window, store them locally, search and organize them, and export/import them anytime.",
  "main": "background.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickravesh/TwoTab.git"
  },
  "keywords": [],
